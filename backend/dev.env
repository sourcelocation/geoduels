# The backend's development settings beside .env, for running it on this machine (.air.toml, Procfile)
# against compose.yaml's services: what compose gives its containers.
POSTGRES_URL=postgres://geoduels:geoduels@localhost:24003/geoduels?sslmode=disable
NATS_URL=nats://localhost:24004
API_URL=http://localhost:24001
CORS_ALLOWED_ORIGINS=http://localhost:24000
# Requests reach the API through Next's dev server, on this machine.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

API_ADDR=:24001
GATEWAY_ADDR=:24002
GAMEPLAY_NODE_ADDR=:24005
GAMEPLAY_NODE_ID=game-1
GAMEPLAY_INTERNAL_URL=http://localhost:24005
# A save or `overmind quit` doesn't wait for matches to finish.
GAMEPLAY_DRAIN_TIMEOUT=2s
MODERATION_WORKER_ADDR=:24006
DISCORD_WORKER_ADDR=:24007

# Imports the bundled sample for any required playable map that isn't configured yet; it never
# replaces existing maps.
DEV_MAP_DATASET=../maps/datasets/a-source-world.sample.json
